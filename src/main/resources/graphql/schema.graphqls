type Query {
    ping: String
    clientes(incluirInactivos: Boolean = false): [Cliente!]!
    cliente(id: ID!): Cliente
    reservas(filtro: ReservaFiltro): [ReservaConsulta!]!
    historialAlquileres: [HistorialAlquiler!]!
}

type Mutation {
    crearCliente(input: ClienteInput!): Cliente!
    actualizarCliente(id: ID!, input: ClienteUpdateInput!): Cliente!
    eliminarCliente(id: ID!): Boolean!
}

type Cliente {
    id: ID!
    usuarioId: ID!
    email: String!
    documento: String!
    nombre: String!
    apellido: String!
    telefono: String
    fechaNacimiento: String
    activo: Boolean!
}

input ClienteInput {
    email: String!
    password: String!
    documento: String!
    nombre: String!
    apellido: String!
    telefono: String
    fechaNacimiento: String
}

input ClienteUpdateInput {
    nombre: String!
    apellido: String!
    telefono: String
    fechaNacimiento: String
}

input ReservaFiltro {
    clienteId: ID
    vehiculoId: ID
    tipoVehiculo: TipoVehiculo
    estado: EstadoReserva
    fechaDesde: String
    fechaHasta: String
}

enum TipoVehiculo {
    SEDAN
    SUV
    PICKUP
    COUPE
    HATCHBACK
}

enum EstadoReserva {
    PENDIENTE
    CONFIRMADA
    CANCELADA
}

type ReservaConsulta {
    id: ID!
    clienteId: ID!
    cliente: String!
    vehiculoId: ID!
    vehiculo: String!
    patente: String!
    fechaInicio: String!
    fechaFin: String!
    precioDiario: String!
    importeTotal: String!
    estado: String!
}

type HistorialAlquiler {
    id: ID!
    vehiculo: String!
    patente: String!
    fechaInicio: String!
    fechaFin: String!
    cantidadDias: Int!
    importeTotal: String!
    estado: String!
}

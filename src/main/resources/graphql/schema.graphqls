type Query {
    ping: String
    clientes(incluirInactivos: Boolean = false): [Cliente!]!
    cliente(id: ID!): Cliente
    reservas(filtro: ReservaFiltro): [ReservaConsulta!]!
    historialAlquileres: [HistorialAlquiler!]!

    """
    Vehículos activos que están libres durante TODO el período indicado (sin reservas confirmadas
    que se superpongan). Requiere rol CLIENTE. Los filtros opcionales se combinan con AND.
    """
    vehiculosDisponibles(filtro: DisponibilidadFiltro!): [VehiculoDisponible!]!
}

type Mutation {
    crearCliente(input: ClienteInput!): Cliente!
    actualizarCliente(id: ID!, input: ClienteUpdateInput!): Cliente!
    eliminarCliente(id: ID!): Boolean!
}

type Cliente {
    id: ID!
    usuarioId: ID!
    email: String!
    documento: String!
    nombre: String!
    apellido: String!
    telefono: String
    fechaNacimiento: String
    activo: Boolean!
}

input ClienteInput {
    email: String!
    password: String!
    documento: String!
    nombre: String!
    apellido: String!
    telefono: String
    fechaNacimiento: String
}

input ClienteUpdateInput {
    nombre: String!
    apellido: String!
    telefono: String
    fechaNacimiento: String
}

input ReservaFiltro {
    clienteId: ID
    vehiculoId: ID
    tipoVehiculo: TipoVehiculo
    estado: EstadoReserva
    fechaDesde: String
    fechaHasta: String
}

"Criterios de búsqueda de disponibilidad. Las fechas son obligatorias; el resto es opcional."
input DisponibilidadFiltro {
    "Inicio del período (ISO-8601, ej. 2026-10-01T10:00). Debe ser futura."
    fechaInicio: String!
    "Fin del período (ISO-8601). Debe ser posterior al inicio."
    fechaFin: String!
    tipoVehiculo: TipoVehiculo
    "Coincidencia parcial, sin distinguir mayúsculas."
    marca: String
    "Coincidencia parcial, sin distinguir mayúsculas."
    modelo: String
    "Precio diario mínimo (inclusive)."
    precioMin: Float
    "Precio diario máximo (inclusive)."
    precioMax: Float
}

"Vehículo disponible para alquilar en el período consultado."
type VehiculoDisponible {
    id: ID!
    patente: String!
    marca: String!
    modelo: String!
    anio: String!
    color: String
    tipoVehiculo: TipoVehiculo
    precioDiario: Float
}

enum TipoVehiculo {
    SEDAN
    SUV
    PICKUP
    COUPE
    HATCHBACK
}

enum EstadoReserva {
    PENDIENTE
    CONFIRMADA
    CANCELADA
}

type ReservaConsulta {
    id: ID!
    clienteId: ID!
    cliente: String!
    vehiculoId: ID!
    vehiculo: String!
    patente: String!
    fechaInicio: String!
    fechaFin: String!
    precioDiario: String!
    importeTotal: String!
    estado: String!
}

type HistorialAlquiler {
    id: ID!
    vehiculo: String!
    patente: String!
    fechaInicio: String!
    fechaFin: String!
    cantidadDias: Int!
    importeTotal: String!
    estado: String!
}
